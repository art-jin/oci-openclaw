# =============================
# Required: OCI basic settings
# =============================
OCI_CLI_PROFILE=DEFAULT
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..REPLACE_ME
# Optional: compartment for OCIR/Artifacts repositories & images.
# If unset, defaults to OCI_COMPARTMENT_OCID.
OCI_ARTIFACTS_COMPARTMENT_OCID=

# Optional now: if not set, 10_deploy_all_in_one.sh can run 00_create_oke_cluster.sh first
OCI_CLUSTER_OCID=ocid1.cluster.oc1..REPLACE_ME
KUBECONFIG_PATH=/Users/arthurjin/.kube/config

# =============================
# OKE creation settings (00_create_oke_cluster.sh)
# =============================
OKE_CLUSTER_NAME=oc-app-oke
OKE_K8S_VERSION=v1.30.1

# PUBLIC or PRIVATE (API endpoint visibility)
OKE_API_ENDPOINT_VISIBILITY=PUBLIC

# new: create VCN/subnets automatically
# existing: reuse existing VCN/subnets below
OKE_VCN_MODE=new

# Only for OKE_VCN_MODE=existing
OKE_VCN_OCID=
OKE_ENDPOINT_SUBNET_OCID=
OKE_WORKER_SUBNET_OCID=
OKE_LB_SUBNET_OCID=

# Only for OKE_VCN_MODE=new
OKE_VCN_CIDR=10.0.0.0/16
OKE_ENDPOINT_SUBNET_CIDR=10.0.10.0/24
OKE_WORKER_SUBNET_CIDR=10.0.20.0/24
OKE_LB_SUBNET_CIDR=10.0.30.0/24

# Node pool
OKE_NODEPOOL_NAME=oc-app-nodepool
OKE_NODE_SHAPE=VM.Standard.E5.Flex
OKE_NODE_OCPUS=1
OKE_NODE_MEMORY_GB=8
OKE_NODE_COUNT=2
OKE_NODE_IMAGE_OCID=

# =============================
# Gateway image
# =============================
GATEWAY_IMAGE_MODE=build
GATEWAY_IMAGE=ord.ocir.io/REPLACE_NAMESPACE/oci-gateway:v1.0.0
GATEWAY_REPO_DIR=../oci-anthropic-gateway

# OCIR push/pull auth
OCIR_REGION_KEY=ord
OCI_USERNAME=REPLACE_USERNAME
OCI_AUTH_TOKEN=REPLACE_AUTH_TOKEN
# OCIR_NAMESPACE=REPLACE_NAMESPACE
OCIR_REPO=oci-gateway
IMAGE_TAG=v1.0.0
CREATE_OCIR_PULL_SECRET=1

# =============================
# Namespaces
# =============================
K8S_GATEWAY_NAMESPACE=gateway-prod
K8S_OC_APP_NAMESPACE=oc-app-prod

# =============================
# Gateway auth mode
# =============================
# workload_identity: run on OKE with OCI Resource Principal (recommended)
# oci_config_secret: mount OCI SDK config/key via k8s Secret (legacy)
AUTH_MODE=workload_identity

# For workload_identity
OCI_RESOURCE_PRINCIPAL_VERSION=2.2
# Default: same as OCI_REGION
OCI_RESOURCE_PRINCIPAL_REGION=

# =============================
# Gateway runtime config
# =============================
DEBUG_UI_AUTH_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
GATEWAY_CONFIG_JSON_FILE=./config.json

# For oci_config_secret (legacy)
OCI_CONFIG_FILE=/Users/arthurjin/.oci/config
OCI_KEY_FILE=/Users/arthurjin/.oci/oci_api_key.pem

# =============================
# Gateway manifests
# =============================
NAMESPACE_MANIFEST=k8s/00-namespace.yaml
DEPLOYMENT_MANIFEST=k8s/04-deployment.yaml
SERVICE_MANIFEST=k8s/05-service-internal-lb.yaml
NETWORK_POLICY_EGRESS_MANIFEST=k8s/06-networkpolicy-egress-template.yaml
NETWORK_POLICY_INGRESS_MANIFEST=

# =============================
# OpenClaw deploy
# =============================
# OpenClaw image mode:
# - prebuilt (default): OPENCLAW_IMAGE must already exist in registry (script will fail-fast check on --apply)
# - build: auto build+push via scripts/oci/02_build_push_openclaw_ocir.sh and override OPENCLAW_IMAGE
OPENCLAW_IMAGE_MODE=prebuilt

# OpenClaw image (OCIR recommended)
OPENCLAW_IMAGE=
OPENCLAW_PUBLIC_EXPOSE=0
# OpenClaw talks to gateway via ClusterIP service DNS
OPENCLAW_GATEWAY_BASE_URL=http://oci-anthropic-gateway.gateway-prod.svc.cluster.local:8000
# OpenClaw expects an API key header value for the gateway provider; gateway may ignore it.
OPENCLAW_GATEWAY_API_KEY=any-value-works

# =============================
# OC_APP deploy + public exposure
# =============================
OC_APP_MANIFEST_DIR=k8s/oc-app
OC_APP_DEPLOYMENT_MANIFEST=k8s/oc-app/08-deployment.yaml
OC_APP_SERVICE_MANIFEST=k8s/oc-app/09-service-clusterip.yaml
OC_APP_DEPLOYMENT_NAME=oc-app
OC_APP_IMAGE=ghcr.io/oc-app/oc-app:latest
OC_APP_CONFIG_JSON_FILE=scripts/oci/app-config.json.example
OC_APP_GATEWAY_BASE_URL=http://oci-anthropic-gateway.gateway-prod.svc.cluster.local:8000
OC_APP_GATEWAY_TOKEN=REPLACE_OC_APP_TOKEN

# Expose oc-app to public internet via OCI LB
OC_APP_PUBLIC_EXPOSE=1
OC_APP_PUBLIC_SERVICE_NAME=oc-app-public
OC_APP_PUBLIC_SERVICE_PORT=18789
OC_APP_PUBLIC_TARGET_PORT=18987

# Verify settings
VERIFY_MODEL_ID=openai.gpt-oss-20b
