# =============================
# Required: OCI basic settings
# =============================
OCI_CLI_PROFILE=DEFAULT
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..aaaaaaaakre3wvnmmhv474r2wrwlgunoeertbdi2v2tp3igwbu5sqyss3euq

# Optional now: if not set, 10_deploy_all_in_one.sh can run 00_create_oke_cluster.sh first
OCI_CLUSTER_OCID=ocid1.cluster.oc1.us-chicago-1.aaaaaaaa2k3b63s5qekwxc7ur3u4p7rsklaxlezyrdxbx45nlcmcdrtbdwjq
KUBECONFIG_PATH=${HOME}/.kube/config

# =============================
# OKE creation settings (00_create_oke_cluster.sh)
# =============================
OKE_CLUSTER_NAME=openclaw-oke
OKE_K8S_VERSION=v1.30.1

# PUBLIC or PRIVATE (API endpoint visibility)
OKE_API_ENDPOINT_VISIBILITY=PUBLIC

# new: create VCN/subnets automatically
# existing: reuse existing VCN/subnets below
OKE_VCN_MODE=existing

# Only for OKE_VCN_MODE=existing
OKE_VCN_OCID=ocid1.vcn.oc1.us-chicago-1.amaaaaaaak7gbriaoqvtibjml2453emzl6urcycndgr5azvmrfqeawmgil4a
OKE_ENDPOINT_SUBNET_OCID=ocid1.subnet.oc1.us-chicago-1.aaaaaaaagoebyr53mm6yumn3zzx55exbnwlypyt42mvhndmwuyy6g7ugv2kq
OKE_WORKER_SUBNET_OCID=ocid1.subnet.oc1.us-chicago-1.aaaaaaaam3n52c7pihpco5tqb4kcyr6x7wwm3yqp6pxqsw3e2ey5pyewikwa
OKE_LB_SUBNET_OCID=ocid1.subnet.oc1.us-chicago-1.aaaaaaaaiwzrroip2yarxvq6ietjuieuwz5pzoj4xpzek6nt4n2gsul7jh4q

# Only for OKE_VCN_MODE=new
OKE_VCN_CIDR=10.0.0.0/16
OKE_ENDPOINT_SUBNET_CIDR=10.0.10.0/24
OKE_WORKER_SUBNET_CIDR=10.0.20.0/24
OKE_LB_SUBNET_CIDR=10.0.30.0/24

# Node pool (your requested default)
OKE_NODEPOOL_NAME=openclaw-nodepool
OKE_NODE_SHAPE=VM.Standard.E5.Flex
OKE_NODE_OCPUS=1
OKE_NODE_MEMORY_GB=8
OKE_NODE_COUNT=2
# Optional: set if you want pin image
OKE_NODE_IMAGE_OCID=

# =============================
# Gateway image
# =============================
# prebuilt: use existing image directly (recommended)
# build: build from GATEWAY_REPO_DIR and push to OCIR
GATEWAY_IMAGE_MODE=build
GATEWAY_IMAGE=ord.ocir.io/REPLACE_NAMESPACE/oci-gateway:v1.0.0
GATEWAY_REPO_DIR=/Users/arthurjin/PycharmProjects/oci-anthropic-gateway0222

# OCIR push/pull auth
OCIR_REGION_KEY=ord
OCI_USERNAME=arthur.jin@oracle.com
OCI_AUTH_TOKEN="(X4Nap[_>rNp[[pC0_[6"
# Optional: script queries by `oci os ns get` if empty
# OCIR_NAMESPACE=REPLACE_NAMESPACE
OCIR_REPO=oci-gateway
IMAGE_TAG=v1.0.0
CREATE_OCIR_PULL_SECRET=1

# =============================
# Namespaces
# =============================
K8S_GATEWAY_NAMESPACE=gateway-prod
K8S_OPENCLAW_NAMESPACE=openclaw-prod

# =============================
# Gateway runtime config
# =============================
DEBUG_UI_AUTH_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
GATEWAY_CONFIG_JSON_FILE=./config.json
OCI_CONFIG_FILE=${HOME}/.oci/config
OCI_KEY_FILE=${HOME}/.oci/oci_api_key.pem

# =============================
# Gateway manifests
# =============================
NAMESPACE_MANIFEST=k8s/00-namespace.yaml
DEPLOYMENT_MANIFEST=k8s/04-deployment.yaml
SERVICE_MANIFEST=k8s/05-service-internal-lb.yaml
NETWORK_POLICY_EGRESS_MANIFEST=k8s/06-networkpolicy-egress-template.yaml
NETWORK_POLICY_INGRESS_MANIFEST=

# =============================
# Openclaw deploy + public exposure
# =============================
OPENCLAW_MANIFEST_DIR=../openclaw/k8s
OPENCLAW_DEPLOYMENT_NAME=openclaw
OPENCLAW_GATEWAY_BASE_URL=http://oci-anthropic-gateway.gateway-prod.svc.cluster.local:8000
OPENCLAW_ENV_BASE_URL_KEY=ANTHROPIC_BASE_URL
OPENCLAW_ENV_API_KEY_KEY=ANTHROPIC_API_KEY
OPENCLAW_GATEWAY_API_KEY=REPLACE_IF_NEEDED

# Expose openclaw to public internet via OCI LB
OPENCLAW_PUBLIC_EXPOSE=1
OPENCLAW_PUBLIC_SERVICE_NAME=openclaw-public
OPENCLAW_PUBLIC_SERVICE_PORT=80
OPENCLAW_PUBLIC_TARGET_PORT=3000
OKE_KUBE_ENDPOINT=PUBLIC_ENDPOINT
