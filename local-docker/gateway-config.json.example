{
  "compartment_id": "ocid1.compartment.oc1..YOUR_COMPARTMENT_ID",

  "endpoint": "https://inference.generativeai.us-chicago-1.oci.oraclecloud.com",

  "model_aliases": {
    "claude-haiku-4-5": "openai.gpt-oss-20b",
    "claude-3-5-sonnet": "openai.gpt-oss-20b",
    "claude-3-haiku": "openai.gpt-oss-20b"
  },

  "model_definitions": {
    "xai.grok-4-fast-non-reasoning": {
      "ocid": "ocid1.generativeaimodel.oc1.us-chicago-1.YOUR_MODEL_OCID",
      "max_tokens_key": "max_tokens",
      "temperature": 0.7
    },
    "xai.grok-4-fast-reasoning": {
      "ocid": "ocid1.generativeaimodel.oc1.us-chicago-1.YOUR_MODEL_OCID",
      "max_tokens_key": "max_tokens",
      "temperature": 0.7
    },
    "xai.grok-code-fast-1": {
      "ocid": "ocid1.generativeaimodel.oc1.us-chicago-1.YOUR_MODEL_OCID",
      "max_tokens_key": "max_tokens",
      "temperature": 0.7
    },
    "openai.gpt-oss-20b": {
      "ocid": "ocid1.generativeaimodel.oc1.us-chicago-1.YOUR_MODEL_OCID",
      "max_tokens_key": "max_completion_tokens",
      "temperature": 0.7
    },
    "openai.gpt-oss-120b": {
      "ocid": "ocid1.generativeaimodel.oc1.us-chicago-1.YOUR_MODEL_OCID",
      "max_tokens_key": "max_completion_tokens",
      "temperature": 0.7
    },
    "openai.gpt-5": {
      "ocid": "ocid1.generativeaimodel.oc1.us-chicago-1.YOUR_MODEL_OCID",
      "max_tokens_key": "max_completion_tokens",
      "temperature": 1.0
    },
    "openai.gpt-oss-20b": {
      "ocid": "ocid1.generativeaimodel.oc1.us-chicago-1.YOUR_MODEL_OCID",
      "max_tokens_key": "max_completion_tokens",
      "temperature": 1.0
    }
  },

  "default_model": "openai.gpt-oss-20b",

  "debug": false,
  "debug_redact_media": true,
  "enable_nl_tool_fallback": false,
  "messages_max_items": 200,

  "rate_limit": {
    "enabled": false,
    "requests": 60,
    "window_sec": 60
  },

  "debug_ui": {
    "enabled": false,
    "dump_dir": "debug_dumps",
    "index_db": "debug_dumps/index.db",
    "scan_interval_sec": 3,
    "auth_mode": "bearer",
    "max_detail_bytes": 2000000
  },

  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "log_level": "warning"
  }
}
