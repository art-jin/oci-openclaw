# =============================================================================
# OCI OpenClaw Local Docker 环境配置
# =============================================================================
# 复制此文件为 .env 并填写实际值
# cp .env.example .env

# =============================================================================
# Gateway 配置
# =============================================================================
# Gateway 镜像（如果使用预构建镜像）
GATEWAY_IMAGE=oci-anthropic-gateway:latest

# Gateway 暴露端口
GATEWAY_PORT=8000

# Gateway 配置文件路径（相对于 local-docker 目录）
GATEWAY_CONFIG_PATH=./gateway-config.json

# OCI 凭证（直接使用宿主机 ~/.oci 目录，无需复制）
OCI_CONFIG_FILE=~/.oci/config
OCI_KEY_FILE=~/.oci/oci_api_key.pem

# Gateway debug 日志目录
GATEWAY_DEBUG_DIR=./debug_dumps

# Gateway 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
GATEWAY_LOG_LEVEL=WARNING

# Debug UI 认证 Token（可选，留空则使用 config 中的配置）
DEBUG_UI_AUTH_TOKEN=

# =============================================================================
# OpenClaw 配置
# =============================================================================
# OpenClaw 镜像（需要先构建: cd ../openclaw0226 && docker build -t openclaw:local .）
OPENCLAW_IMAGE=openclaw:local

# OpenClaw Gateway 端口（宿主机:容器）
OPENCLAW_GATEWAY_PORT=18789

# OpenClaw 绑定地址: loopback, lan, all
OPENCLAW_BIND=lan

# OpenClaw 配置目录
OPENCLAW_CONFIG_DIR=./openclaw-config

# OpenClaw 工作空间目录
OPENCLAW_WORKSPACE_DIR=./workspace

# OpenClaw Gateway Token（用于客户端认证）
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token

# 可选：Web UI Session Keys
# CLAUDE_AI_SESSION_KEY=
# CLAUDE_WEB_SESSION_KEY=
# CLAUDE_WEB_COOKIE=
